// list members: insert, remove, search, sort (stable, natural or by a function), slice and copy
class Person
  Name = ""
  Age = 0
end
fn Older(a, b) = a.Age > b.Age
fn ByLength(a, b) = a.Length < b.Length
let l = [5, 3, 8, 1]
l.Insert(0, 9)
l.Insert(5, 7)
print(l)
print(l.RemoveAt(1))
l.Remove(8)
l.Remove(42)
print(l)
print("{l.Has(3)} {l.Has(4)} {l.IndexOf(1)} {l.IndexOf(4)}")
l.Reverse()
print(l)
l.Sort()
print(l)
print(l.Slice(1, 2))
let c = l.Copy()
c.Clear()
print("{c.Count} {l.Count}")
let w = ["pear", "fig", "apple"]
w.Sort()
print(w)
w.Sort(ByLength)
print(w)
let ps = [Person(Name: "a", Age: 3), Person(Name: "b", Age: 9), Person(Name: "c", Age: 3)]
ps.Sort(Older)
print("{ps[0].Name}{ps[1].Name}{ps[2].Name}")
print([[1, 2], [3]].Has([3]))
try
  l.Insert(9, 1)
catch e
  print(e)
end
// out: [9, 5, 3, 8, 1, 7]
// out: 5
// out: [9, 3, 1, 7]
// out: true false 2 -1
// out: [7, 1, 3, 9]
// out: [1, 3, 7, 9]
// out: [3, 7]
// out: 0 4
// out: ["apple", "fig", "pear"]
// out: ["fig", "pear", "apple"]
// out: bac
// out: true
// out: cannot insert at 9: the list has 4 items
