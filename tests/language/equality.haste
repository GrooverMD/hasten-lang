// = compares lists and dictionaries by what they hold; objects by being the same object
print([1, 2] = [1, 2])
print([1, 2] <> [1, 2])
print([1, 2] = [2, 1])
print([[1], [2, 3]] = [[1], [2, 3]])
print({"a": 1, "b": 2} = {"b": 2, "a": 1})
print({"a": [1]} = {"a": [2]})
class P
  x = 1
end
let p = P()
print(p = p)
print(P() = P())
// out: true
// out: false
// out: false
// out: true
// out: true
// out: false
// out: true
// out: false
