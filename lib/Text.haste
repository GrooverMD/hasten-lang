// Text: string helpers.
extern fn Upper(s: string): string = "hs_upper"                              // capitals: ASCII, accented Latin, Greek and Cyrillic
extern fn Lower(s: string): string = "hs_lower"                              // small letters: ASCII, accented Latin, Greek and Cyrillic
extern fn PadRight(s: string, width: int): string = "hs_pad_right"           // spaces after s up to width characters; never shortens
extern fn Repeat(s: string, count: int): string = "hs_repeat"                // s count times; empty for count <= 0
extern fn Code(s: string, index: int): int = "hs_code"                       // the character code at position index
extern fn Sub(s: string, start: int, count: int): string = "hs_sub"          // count characters from position start; outside the text is an error
extern fn Find(s: string, code: int, from: int): int = "hs_find"             // position of the next character code at or after from, or the length if none
extern fn IndexOf(s: string, part: string, from: int): int = "hs_find_text"  // position of the next part at or after from, or the length if none
extern fn Contains(s: string, part: string): bool = "hs_contains"            // whether part is somewhere in s
extern fn Split(s: string, separator: string): [string] = "hs_split"         // the pieces between each separator
extern fn Join(items: [string], separator: string): string = "hs_join"       // the items with separator between them
extern fn Trim(s: string): string = "hs_trim"                                // spaces removed from both ends
extern fn Replace(s: string, old: string, new: string): string = "hs_replace"// every old replaced with new
extern fn ToInt(s: string): int = "hs_to_int"                                // text as a whole number; spaces around are allowed, anything else is an error
extern fn ToFloat(s: string): float = "hs_to_float"                          // text as a decimal; spaces around are allowed, anything else is an error
extern fn StartsWith(s: string, prefix: string): bool = "hs_starts_with"     // whether s begins with prefix
extern fn EndsWith(s: string, suffix: string): bool = "hs_ends_with"         // whether s ends with suffix
extern fn PadLeft(s: string, width: int): string = "hs_pad_left"           // spaces before s up to width
extern fn Char(code: int): string = "hs_encode"                              // the character with this code
extern fn TrimStart(s: string): string = "hs_trim_start"                     // spaces removed from the start
extern fn TrimEnd(s: string): string = "hs_trim_end"                         // spaces removed from the end
extern fn Reverse(s: string): string = "hs_reverse"                          // by characters
extern fn LastIndexOf(s: string, part: string): int = "hs_last_index_of"     // -1 when not there
extern fn Lines(s: string): [string] = "hs_lines"                            // \n or \r\n
extern fn IsDigit(code: int): bool = "hs_is_digit"                           // 0 to 9
extern fn IsSpace(code: int): bool = "hs_is_space"                           // space, tab, line breaks
extern fn IsLetter(code: int): bool = "hs_is_letter"                         // ASCII, accented Latin, Greek, Cyrillic

fn Banner(title: string): string = "== {Upper(title)} =="   // a title for printed output
fn Line(width: int): string = Repeat("-", width)               // a line of dashes
