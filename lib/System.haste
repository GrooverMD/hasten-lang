// System: core types. Nothing is imported; the compiler finds what you use.
extern fn FileOpen(path: string): int = "hs_file_open"
extern fn FileByte(file: int, value: int) = "hs_file_byte"
extern fn FileClose(file: int) = "hs_file_close"
extern fn ReadText(path: string): string = "hs_read_file"

fn Write(value) = print(Str(value))

fn Rgb(r, g, b) = Int(r) * 65536 + Int(g) * 256 + Int(b)

fn WriteLE(file, value, count)
  v = value
  for i in 1..count
    FileByte(file, v mod 256)
    v = v div 256
  end
end

class Bitmap
  Width = 1 where it > 0
  Height = 1 where it > 0
  Pixels: [int] = []

  fn Ready()
    if Pixels.Count = 0
      for i in 1..Width * Height
        Pixels.Add(0)
      end
    end
  end

  fn Pixel(x, y)
    Ready()
    return Pixels[y * Width + x]
  end

  fn SetPixel(x, y, color)
    Ready()
    Pixels[y * Width + x] = color
  end

  fn Save(path)
    Ready()
    pad = (4 - Width * 3 mod 4) mod 4
    f = FileOpen(path)
    FileByte(f, 66)
    FileByte(f, 77)
    WriteLE(f, 54 + (Width * 3 + pad) * Height, 4)
    WriteLE(f, 0, 4)
    WriteLE(f, 54, 4)
    WriteLE(f, 40, 4)
    WriteLE(f, Width, 4)
    WriteLE(f, Height, 4)
    WriteLE(f, 1, 2)
    WriteLE(f, 24, 2)
    WriteLE(f, 0, 24)
    for row in 1..Height
      y = Height - row
      for x in 0..Width - 1
        c = Pixels[y * Width + x]
        FileByte(f, c mod 256)
        FileByte(f, c div 256 mod 256)
        FileByte(f, c div 65536)
      end
      WriteLE(f, 0, pad)
    end
    FileClose(f)
  end
end
