// decimals print in their shortest form, up to 15 digits, that reads back as the same number
print(250.0)
print(1234567.5)
print(0.1 + 0.2)
print(9.0)
print(1.0 / 3.0)
print(-2.5)
print(0.00001234)
print(100000000000000.0)
print(1.0 / 0.0)
let x = 1234567.5
print("{x} and {x:2}")
print(Str(0.5))
// out: 250
// out: 1234567.5
// out: 0.3
// out: 9
// out: 0.333333333333333
// out: -2.5
// out: 1.234e-05
// out: 100000000000000
// out: inf
// out: 1234567.5 and 1234567.50
// out: 0.5
