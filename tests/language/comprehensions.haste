// building lists: [value for x in source where condition]
squares = [x * x for x in 1..5]
print(squares)
// out: [1, 4, 9, 16, 25]
words = ["drill", "blast", "load", "haul", "crusher"]
print([w for w in words where w.Length > 4])
// out: ["drill", "blast", "crusher"]
print([Text.Upper(w) for w in words where Text.StartsWith(w, "b")])
// out: ["BLAST"]
d = {"a": 1, "b": 2}
print([k + k for k in d])
// out: ["aa", "bb"]
grid = [[r * 10 + c for c in 1..3] for r in 1..2]
print(grid)
// out: [[11, 12, 13], [21, 22, 23]]
let f: [float] = [x / 2 for x in 1..3]
print(f)
// out: [0.5, 1, 1.5]
none = [x for x in 1..10 where x > 100]
none.Add(7)
print(none)
// out: [7]
x = 3
print([x + 1 for x in 1..x])
// out: [2, 3, 4]
print(x)
// out: 3
fn Evens(l) = [n for n in l where n mod 2 = 0]
print(Evens([1, 2, 3, 4, 5, 6]))
// out: [2, 4, 6]
long = [
  w
  for w in words
  where w.Length = 4
]
print(long)
// out: ["load", "haul"]
