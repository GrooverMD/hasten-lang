// Text: string helpers.
extern fn Upper(s: string): string = "hs_upper"
extern fn Lower(s: string): string = "hs_lower"
extern fn PadRight(s: string, width: int): string = "hs_pad_right"
extern fn Repeat(s: string, count: int): string = "hs_repeat"
extern fn Code(s: string, index: int): int = "hs_code"
extern fn Sub(s: string, start: int, count: int): string = "hs_sub"
extern fn Find(s: string, code: int, from: int): int = "hs_find"
extern fn IndexOf(s: string, part: string, from: int): int = "hs_find_text"
extern fn Contains(s: string, part: string): bool = "hs_contains"
extern fn Split(s: string, separator: string): [string] = "hs_split"
extern fn Join(items: [string], separator: string): string = "hs_join"
extern fn Trim(s: string): string = "hs_trim"
extern fn Replace(s: string, old: string, new: string): string = "hs_replace"
extern fn ToInt(s: string): int = "hs_to_int"
extern fn ToFloat(s: string): float = "hs_to_float"

fn Banner(title: string): string = "== {Upper(title)} =="
fn Line(width: int): string = Repeat("-", width)
