// lists: literals, Add, Count, indexing, empty lists typed by their first Add
nums = [3, 1, 4]
nums.Add(1)
nums[1] = 9
print("{nums.Count} {nums[0]} {nums[1]} {nums[3]}")
squares = []
for i in 1..5
  squares.Add(i * i)
end
total = 0
for s in squares
  total = total + s
end
print(total)
names = []
names.Add("x")
print(names.Count)
grid = [[1, 2], [3, 4]]
print(grid[1][0])
try
  print(nums[4])
catch e
  print(e)
end
// out: 4 3 9 1
// out: 55
// out: 1
// out: 3
// out: index 4 is outside 0..3
