// Fractal: renders the Mandelbrot set and saves it as a PNG. The drawing is in Generate.haste.

switch Width = 1200 where it >= 16 and it <= 20000      // image width in pixels
switch Height = 800 where it >= 16 and it <= 20000      // image height in pixels
switch Limit = 256 where it >= 16                       // iterations per pixel: more is slower and finer

start = Time.Elapsed()
img = Generate.Mandelbrot(Width, Height, Limit)

switch Out = "fractal.png"                              // file to save

Png.Save(img, Out)
print("Rendered {img.Width} x {img.Height} to {Out} in {Time.Elapsed() - start:2} seconds")
